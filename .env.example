# ============================================================
#  KDPD — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
#  Copy file này thành .env rồi điền giá trị thật cho các placeholder
#  Ví dụ:  cp .env.example .env  ;  nano .env
# ============================================================

# ── PostgreSQL DATABASE ─────────────────────────────────────
# Format chuẩn: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
# Lưu ý: password không được chứa ký tự : @ / ? (nếu có cần URL encode)
DATABASE_URL=postgresql://kdpd_user:__CHANGEME_DB_PASSWORD__@localhost:5433/kdpd_db?schema=public

# ── SERVER PORT & MODE ─────────────────────────────────────
PORT=5000
NODE_ENV=production
# Đặt =1 nếu đứng sau Nginx reverse proxy (để Express đọc đúng IP thật của client)
TRUST_PROXY=1

# ── SESSION & SECURITY ─────────────────────────────────────
# SESSION_SECRET: chuỗi ngẫu nhiên TỐI THIỂU 32 ký tự — KHÔNG ĐỢT MẪU NÀY LÊN PROD
# Tạo nhanh:  openssl rand -hex 24
SESSION_SECRET=__CHANGEME_RANDOM_32CHARS_PLUS__
# SESSION_SECURE=true (HTTPS production) / false (localhost HTTP dev)
SESSION_SECURE=false
# Kiểm tra CSRF header cho các request state-changing:
CSRF_CHECK=true
# Danh sách origin được phép submit form (phải khớp chính xác URL browser, phân cách bằng dấu phẩy):
CSRF_ORIGIN=http://task.kdpd.local,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5000

# ── GMAIL / SMTP (gửi email thông báo / login link) ────────
GMAIL_USER=your-app@gmail.com
# Nếu dùng Gmail 2FA → cần tạo "App password" 16 ký tự (không dùng password tài khoản):
GMAIL_APP_PASSWORD=__CHANGEME_GMAIL_APP_PASSWORD_16CHARS__
MAIL_FROM="KDPD System <your-app@gmail.com>"
MAIL_SUBJECT_PREFIX="[KDPD]"

# ── GOOGLE OAUTH2 (Login Google / Google Drive backup / Google Calendar Sync)
# Xem hướng dẫn tạo credentials: Docs/GOOGLE_OAUTH_SETUP.md
GOOGLE_CLIENT_ID=__CHANGEME_GOOGLE_CLIENT_ID__.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=__CHANGEME_GOOGLE_CLIENT_SECRET__
# Refresh token có độ dài 200+ ký tự, tạo qua OAuth Playground (scope https://mail.google.com + drive):
GOOGLE_REFRESH_TOKEN=__CHANGEME_GOOGLE_REFRESH_TOKEN_200PLUS_CHARS__
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
# Google Calendar webhook public URL (thường dùng ngrok free):
GOOGLE_CALENDAR_REDIRECT_URI=__CHANGEME_PUBLIC_NGROK_OR_DOMAIN__/api/google/calendar/oauth2callback

# ── BACKUP DATABASE (TÙY CHỌN) ──────────────────────────────────────────────
# PG_DUMP_PATH: CHỈ WINDOWS CẦN (nếu không tìm thấy pg_dump.exe trong Program Files). LINUX BỎ TRỐNG.
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe

# BACKUP_LOCAL_DIR: Đường dẫn LƯU FILE .dump (nếu bỏ trống mặc định <project_root>/backups)
# BACKUP_LOCAL_DIR=/home/deploy/backups

# GOOGLE_DRIVE_FOLDER_ID: ID thư mục Google Drive (lấy từ URL khi mở thư mục /folders/XXXXXXX )
# GOOGLE_DRIVE_FOLDER_ID=__CHANGEME_GOOGLE_DRIVE_FOLDER_ID__

# ── OPTIONAL: ONE DRIVE / MICROSOFT 365 (stub — triển khai sau khi có AZURE credentials)
# AZURE_TENANT_ID=__CHANGEME_AZURE_TENANT__
# AZURE_CLIENT_ID=__CHANGEME_AZURE_APP_CLIENT_ID__
# ONEDRIVE_FOLDER_ID=__CHANGEME_ONEDRIVE_FOLDER_ID__

# ── OTHER ──────────────────────────────────────────────────
# Bật Content-Security-Policy (chỉ production HTTPS, dev nên tắt cho Vite HMR)
CSP_ENABLED=false
